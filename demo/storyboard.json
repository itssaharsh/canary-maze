   "actions": [
    {
     "do": "pause",
     "ms": 500
    },
    {
     "do": "camera",
     "focus": ".claim",
     "zoom": "fit",
     "at": "secret",
     "move": "push"
    },
    {
     "do": "pause",
     "ms": 2600
    }
   ]
  },
  {
   "id": "diff",
   "type": "live",
   "mode": "window",
   "say": "A URL only context A was ever shown was requested by context B. Different user agent, different network. This one is a seeded replay, and the page says so itself.",
   "actions": [
    {
     "do": "camera",
     "focus": "#diff",
     "zoom": "fit",
     "at": "requested",
     "move": "push"
    },
    {
     "do": "pause",
     "ms": 3000
    },
    {
     "do": "camera",
     "focus": "#records",
     "zoom": "fit",
     "at": "seeded",
     "move": "pull"
    },
    {
     "do": "pause",
     "ms": 1800
    }
   ]
  },
  {
   "id": "records",
   "type": "live",
   "mode": "window",
   "speed": 0.86,
