     "timeout": 25000
    },
    {
     "do": "pause",
     "ms": 900
    }
   ],
   "speed": 0.78
  },
  {
   "id": "caught",
   "type": "live",
   "mode": "window",
   "say": "Caught. The bundle commits to what the page shows, not only to what it hashes. An earlier build of this got that wrong, and an independent review found it.",
   "actions": [
    {
     "do": "camera",
     "focus": "#verify-result",
     "zoom": "fit",
     "at": "Caught",
     "move": "push"
    },
    {
     "do": "pause",
     "ms": 2600
    },
    {
     "do": "camera",
     "focus": "#verify",
     "zoom": "fit",
     "at": "shows",
     "move": "pull"
    },
    {
     "do": "pause",
     "ms": 2000
    }
