    {
     "do": "camera",
     "focus": "#verify-result",
     "zoom": "fit",
     "at": "Verified",
     "move": "pull"
    },
    {
     "do": "pause",
     "ms": 2800
    }
   ]
  },
  {
   "id": "tamper",
   "type": "live",
   "mode": "window",
