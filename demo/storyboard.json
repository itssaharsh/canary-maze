     "focus": "#foot",
     "zoom": "fit",
     "at": "displays",
     "move": "push"
    },
    {
     "do": "eval",
     "js": "window.CANARY_DATA.counts.sightings_organic = 4127; document.getElementById('foot').innerHTML = document.getElementById('foot').innerHTML.replace(/Organic sightings <b[^>]*>0<\\/b>/, 'Organic sightings <b>4127</b>'); true",
