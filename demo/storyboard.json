 "scenes": [
  {
   "id": "hook",
   "type": "clip",
   "from": "aha",
   "offset": -0.6,
   "say": "This was just checked with our server switched off. Nothing was contacted.",
   "card": {
    "layout": "title",
    "scale": "hero",
    "kicker": "Canary Maze",
    "title": "Proof that doesn't need you to trust us.",
    "reveal": "write"
   }
  },
  {
   "id": "problem",
   "type": "card",
   "speed": 0.74,
   "say": "When one automated client reads your site and hands what it found to another, all you can usually say is that the two look similar.",
   "card": {
    "layout": "stat",
    "value": "\u201cthey look similar\u201d",
    "label": "the strongest thing a site operator can say today",
    "reveal": "mask"
   }
  },
  {
   "id": "claim",
   "type": "live",
   "mode": "window",
