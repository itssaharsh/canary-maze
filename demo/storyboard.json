      "text": "issued to A \u00b7 fetched by B"
     }
    },
    {
     "do": "pause",
     "ms": 2600
    }
   ]
  },
  {
   "id": "verify",
   "type": "live",
   "mode": "window",
   "say": "Now the part that matters. This recomputes every hash in your own browser, from the bundle alone. Verified. Five hashes, with crypto.subtle, and no request to our server at all.",
   "actions": [
    {
     "do": "camera",
     "focus": "#verify",
     "zoom": "fit",
     "at": "recomputes",
     "move": "push"
    },
    {
