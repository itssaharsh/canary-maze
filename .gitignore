__pycache__/
*.pyc
.venv/
node_modules/
qa/
.pytest_cache/

# secrets
.env

# build outputs: regenerated by `make demo`, so never committed. A committed copy
# would be a stale snapshot of a ledger that has since moved on.
bundles/
viewer/data.js
viewer/data.json
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# graphify scratch (the built outputs graph.json / graph.html / GRAPH_REPORT.md are kept)
graphify-out/.graphify_*
graphify-out/cost.json

# runtime scratch
.serve.log
.tunnel.log
.pubtest.log

# carries live canary URLs; publishing it lets any reader fabricate a sighting
docs/paste_log.json
viewer/.vercel
site/.vercel

# Ledgers are evidence, not source. The written reason a ledger was retired IS
# source, so the archive README is kept and the databases beside it are not.
ledgers/**/*.sqlite3
ledgers/**/*.sqlite3-wal
ledgers/**/*.sqlite3-shm

# keep_alive.sh runtime state
.ingest_url
.flask.pid
.tunnel.pid
.keepalive.log
.keepalive.pid

# Video working files: frames, stills and renders are large and regenerable.
# The storyboard, brief and shot list are the source and are kept.
demo/*
!demo/storyboard.json
!demo/brief.md
!demo/shots.md
!demo/design.json
.public_url
.serve_public.out
.serve.log
.tunnel.log
bundles/
