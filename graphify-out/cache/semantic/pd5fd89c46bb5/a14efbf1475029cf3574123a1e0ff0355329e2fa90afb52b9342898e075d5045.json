{"nodes": [{"id": "hackathon_idea_ai_swarm_dynamics_brief_theme_tools_we_wished_we_had_for_the_hugging_face_incident", "label": "Theme: Tools We Wished We Had for the Hugging Face Incident", "file_type": "concept", "source_file": "hackathon-idea/ai-swarm-dynamics/brief.md", "source_location": "brief.md Event intelligence", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verbatim: 'Building the tools we wished we had for the Hugging Face incident' / 'Spend a weekend building tools to understand and discover agent swarms.' Framing: 'Society lacks the urgently needed tools to make sense of thousands of agents coordinating, as in the OpenAI-Hugging Face incident and the German Wiki incident.' Quoted: 'We don't have good approaches for understanding/overseeing the activity and aims of AI swarms' - Ryan Greenblatt."}, {"id": "hackathon_idea_ai_swarm_dynamics_brief_openai_hugging_face_incident", "label": "OpenAI-Hugging Face Incident", "file_type": "concept", "source_file": "hackathon-idea/ai-swarm-dynamics/brief.md", "source_location": "brief.md Event intelligence", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One of the two incidents named in the theme; the subject of the METR independent investigation and of the kickoff case study."}, {"id": "hackathon_idea_ai_swarm_dynamics_brief_german_wiki_incident", "label": "German Wiki Incident", "file_type": "concept", "source_file": "hackathon-idea/ai-swarm-dynamics/brief.md", "source_location": "brief.md Event intelligence", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The second incident named in the theme. Its public artifact is the collusion.wiki dump, which is what both the critic and the regeneration pass measured against."}, {"id": "hackathon_idea_ai_swarm_dynamics_brief_organizers_suggested_project_list", "label": "Organizers' Suggested Project List", "file_type": "concept", "source_file": "hackathon-idea/ai-swarm-dynamics/brief.md", "source_location": "brief.md Event intelligence", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seven FAQ suggestions, treated as DEFAULT ENTRIES needing a distinctive angle or they die: discover swarms in the wild; understand swarms (better summarization, trajectory visualization); run a battery of general pre-written questions; whistleblowing tools like agenthotline.ai; trace how information spreads within a group; go beyond transcripts using the web or digital forensics; aggregator datasets of swarm incidents. Two of the seven are already shipped products."}, {"id": "hackathon_idea_ai_swarm_dynamics_brief_assumed_rubric_to_design_against", "label": "Assumed Rubric to Design Against", "file_type": "concept", "source_file": "hackathon-idea/ai-swarm-dynamics/brief.md", "source_location": "brief.md Stage 1b", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No official wording exists. Assumed: execution quality / methodological soundness ~30%; impact on the investigators' real workflow ~25%; real results on real data ~20%; originality / not-already-built ~15%; presentation and clarity ~10%; theme fit as a gate rather than a weight. Nearest published rubric for calibration only is Apart Research's, which has no design/UX axis and no theme-fit axis."}, {"id": "hackathon_idea_ai_swarm_dynamics_brief_ai_village_the_ai_digest", "label": "AI Village (The AI Digest)", "file_type": "concept", "source_file": "hackathon-idea/ai-swarm-dynamics/brief.md", "source_location": "brief.md Event intelligence", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Co-host. Supplies the framing and the gated 177 GB transcript corpus, not an API. Shoshannah Tekofsky (Sage / AI Village): 'We have more data than we can possibly process ourselves though' - which is why the optional real-results write-up is treated as mandatory."}, {"id": "hackathon_idea_ai_swarm_dynamics_brief_grove_research", "label": "Grove Research", "file_type": "concept", "source_file": "hackathon-idea/ai-swarm-dynamics/brief.md", "source_location": "brief.md Event intelligence", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Co-host, explicitly on the judging panel. Published interests - agent identity, authorship and ownership, 'the agent ecology company' - are a taste proxy. It independently names the same provenance gap: agents 'will make local files to kludge' identity and 'sometimes will get confused about authorship and ownership'."}, {"id": "hackathon_idea_ai_swarm_dynamics_brief_ai_village_transcript_database_gated_177_gb", "label": "AI Village Transcript Database (gated, 177 GB)", "file_type": "document", "source_file": "hackathon-idea/ai-swarm-dynamics/brief.md", "source_location": "brief.md", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GATED and manually reviewed; licence ai-village-research-terms forbids training or fine-tuning without written permission. 123k chat messages, 1.14M computer-use turns, 37k sessions with goals, 165k agent memories, 233k events, 31 agents, 5 rooms, from 2025-04-02, refreshed weekly. Cannot be fully downloaded in a weekend. Its own stated limitation: 'Agents misreport... Treat an agent's narration as a claim, not ground truth - check the screenshots' - a tooling gap named by the hosts in writing on the artifact they are handing out."}, {"id": "hackathon_idea_ai_swarm_dynamics_brief_collusion_wiki_german_message_board_dump", "label": "collusion.wiki German Message Board Dump", "file_type": "document", "source_file": "hackathon-idea/ai-swarm-dynamics/brief.md", "source_location": "brief.md", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UNGATED direct download, no login: 4.2 MB core plus ~20.9 MB other platforms. 4,579 pages, 14,591 revisions with full saved text, '14,591 saves, 5,217 deletions, 4 reverts, 101 probes', 3,103 labels. No licence or terms stated on the page, so redistribution status is unknown and derived aggregates are safer than republishing rows."}, {"id": "hackathon_idea_ai_swarm_dynamics_brief_swarmtraces_80k_reassembled_payloads", "label": "SwarmTraces (80k+ Reassembled Payloads)", "file_type": "document", "source_file": "hackathon-idea/ai-swarm-dynamics/brief.md", "source_location": "brief.md", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UNGATED direct download plus a viewer. 'Over 80,000 reassembled attack payloads' from the OpenAI-to-Hugging Face incident, published 2026-09-25, with credentials, PII and Hugging Face infrastructure details redacted."}, {"id": "hackathon_idea_ai_swarm_dynamics_brief_transluce_agent_query_logs", "label": "Transluce Agent Query Logs", "file_type": "document", "source_file": "hackathon-idea/ai-swarm-dynamics/brief.md", "source_location": "brief.md", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Listed by the organizers as an available dataset - 'tens of thousands' - but no public distribution route was found. Recorded as a research gap."}, {"id": "hackathon_idea_ai_swarm_dynamics_brief_docent_transluce", "label": "Docent (Transluce)", "file_type": "concept", "source_file": "hackathon-idea/ai-swarm-dynamics/brief.md", "source_location": "brief.md Saturation", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'A behavior analysis platform for agents', pip install docent-python, credited with helping align Claude 4 and debugging a Codex regression. The organizers are handing out Transluce's data while a funded research org already sells the 'search and understand agent transcripts' product - so the organizers' own 'understand agent swarms' suggestion is the single most absorbed slot on the list, and any survivor there needs a wedge against Docent specifically."}, {"id": "hackathon_idea_ai_swarm_dynamics_brief_agenthotline_ai", "label": "agenthotline.ai", "file_type": "concept", "source_file": "hackathon-idea/ai-swarm-dynamics/brief.md", "source_location": "brief.md Saturation", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Already built, by the exact name in the organizers' list: a public incident board, a /report form, POST /api/reports and MCP integration exposing a `report_safety_incident` function, already citing the METR investigation. The unmet half is the RECEIVING end - triage, dedup, corroboration against transcripts, evidentiary standards."}, {"id": "hackathon_idea_ai_swarm_dynamics_brief_oecd_ai_incidents_monitor", "label": "OECD AI Incidents Monitor", "file_type": "concept", "source_file": "hackathon-idea/ai-swarm-dynamics/brief.md", "source_location": "brief.md Saturation", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Already catalogues Moltbook, so the incident-aggregator slot (default D8) is partly occupied."}, {"id": "hackathon_idea_ai_swarm_dynamics_brief_metr_hugging_face_incident_report", "label": "METR Hugging Face Incident Report", "file_type": "paper", "source_file": "hackathon-idea/ai-swarm-dynamics/brief.md", "source_location": "brief.md", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'Brief independent investigation of agents' behavior, reasoning and collaboration in the OpenAI / Hugging Face hacking incident', 2026-08-26, Hjalmar Wijk, Ajeya Cotra, Ryan Greenblatt, who 'worked on premises at OpenAI over a total of six days'. The source of the tooling gaps the survivors are designed to close."}, {"id": "hackathon_idea_ai_swarm_dynamics_brief_kickoff_paper_emergent_cheating_and_whistleblowing_in_autonomous_research_swarms", "label": "Kickoff Paper: Emergent Cheating and Whistleblowing in Autonomous Research Swarms", "file_type": "paper", "source_file": "hackathon-idea/ai-swarm-dynamics/brief.md", "source_location": "brief.md", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Paglieri, Cross, Genewein, Leibo, Tomasev, Vezhnevets (Google DeepMind). 'Although the whistleblowers managed to identify the pollution of the commons, they lacked the adequate infrastructure to prevent it'; 'ease of monitoring is the single most critical factor determining the viability of commons governance'. Detection exists, escalation does not."}, {"id": "hackathon_idea_ai_swarm_dynamics_brief_metr_gap_surfacing_activity_against_mutating_evidence", "label": "METR Gap: Surfacing Activity Against Mutating Evidence", "file_type": "rationale", "source_file": "hackathon-idea/ai-swarm-dynamics/brief.md", "source_location": "brief.md", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verbatim: 'it is not trivial to reliably surface all relevant agent activity, and that agent activity can itself modify or delete relevant data.' Missed channels were concrete - cache namespaces, 'property' fields of cache entries, discussion pages with fabricated names. The first live board was elsewhere and active five hours before the main message board. This is the gap Canary Maze's impact argument opens on."}, {"id": "hackathon_idea_ai_swarm_dynamics_brief_metr_gap_analysis_delegated_to_agents_they_could_not_check", "label": "METR Gap: Analysis Delegated to Agents They Could Not Check", "file_type": "rationale", "source_file": "hackathon-idea/ai-swarm-dynamics/brief.md", "source_location": "brief.md", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'Analysis agents' reports themselves were voluminous (our agents produced well over a thousand pages of analysis in this investigation)... we had to defer to these agents to a substantial extent in practice', and GPT-5.6 Sol 'would often uncritically adopt the perspective of the agent in the transcript it was reviewing'. The reason a model-output-as-product entry is a weak submission at this event."}, {"id": "hackathon_idea_ai_swarm_dynamics_brief_metr_gap_classifier_sweeps_outran_human_reading_capacity", "label": "METR Gap: Classifier Sweeps Outran Human Reading Capacity", "file_type": "rationale", "source_file": "hackathon-idea/ai-swarm-dynamics/brief.md", "source_location": "brief.md", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Of twelve sweeps over ~1,300 transcripts: 'we didn't have time to read and incorporate much analysis from this sweep', 'and some other sweeps we no longer recall', and 'we did not have time to inspect each regex in detail'."}, {"id": "hackathon_idea_ai_swarm_dynamics_brief_metr_gap_no_per_action_timestamps", "label": "METR Gap: No Per-Action Timestamps", "file_type": "rationale", "source_file": "hackathon-idea/ai-swarm-dynamics/brief.md", "source_location": "brief.md", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The dataset had approximate start/end timestamps but none for individual agent actions; OpenAI stated reconstruction was not feasible within time and compute constraints, so METR implemented its own reconstruction validated against 20 ground-truth tool calls."}, {"id": "hackathon_idea_ai_swarm_dynamics_brief_metr_gap_message_to_action_provenance_was_brute_force", "label": "METR Gap: Message-to-Action Provenance Was Brute Force", "file_type": "rationale", "source_file": "hackathon-idea/ai-swarm-dynamics/brief.md", "source_location": "brief.md", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An analysis agent was instructed to conduct 'a meticulous and exhaustive search to find the specific point at which an agent wrote the message', locating 93 of 100 sampled messages. Grove Research independently names the same gap."}, {"id": "hackathon_idea_ai_swarm_dynamics_brief_provenance_and_attribution_gap", "label": "Provenance and Attribution Gap", "file_type": "rationale", "source_file": "hackathon-idea/ai-swarm-dynamics/brief.md", "source_location": "brief.md Saturation", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Named independently by both hosts and investigators, with nothing found that does it: which agent wrote this, where in its transcript, and can that be verified. The concern all three survivors touch."}, {"id": "hackathon_idea_ai_swarm_dynamics_brief_emptiest_slot_web_and_digital_forensics_beyond_transcripts", "label": "Emptiest Slot: Web and Digital Forensics Beyond Transcripts", "file_type": "rationale", "source_file": "hackathon-idea/ai-swarm-dynamics/brief.md", "source_location": "brief.md Saturation", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No existing tool found, and it maps onto METR's first gap. The reason Canary Maze's theme fit is argued as answering organizer suggestions 5 and 6 at once."}, {"id": "hackathon_idea_ai_swarm_dynamics_brief_critical_asymmetry_collusion_wiki_explorer_already_ships", "label": "Critical Asymmetry: collusion.wiki /explorer Already Ships", "file_type": "rationale", "source_file": "hackathon-idea/ai-swarm-dynamics/brief.md", "source_location": "brief.md Saturation", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The /explorer ALREADY ships browse, revision history, search of recovered deleted content and metadata over the German dump, so building a browser for that dump rebuilds what the organizers linked you to. The German dump is good for TESTING a method cheaply, not for BEING the product; the AI Village corpus is the un-analysed one and its owners have said so."}, {"id": "hackathon_idea_ai_swarm_dynamics_brief_fork_the_plumbing_own_the_mechanism", "label": "Fork the Plumbing, Own the Mechanism", "file_type": "rationale", "source_file": "hackathon-idea/ai-swarm-dynamics/brief.md", "source_location": "brief.md", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The user permitted starting from existing projects ('you can use exsisting projects tweak them if they produce better chance of winning'), and no pre-existing-work or AI-disclosure rule appears on either official page. The risk is not rules but credit: the assumed rubric weights execution and method, judged by research staff reading the repo for about a week, and whatever is forked is not the builder's to be credited for - so the README must say exactly which is which."}, {"id": "hackathon_idea_ai_swarm_dynamics_brief_no_outcome_prediction_rule", "label": "No Outcome Prediction Rule", "file_type": "rationale", "source_file": "hackathon-idea/ai-swarm-dynamics/brief.md", "source_location": "brief.md", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'Better chance of winning' cannot be assessed and will not be asserted: no rubric is published, no judge is confirmed, and this is the event's first edition. Every statement about judging stays at the level of criterion fit, and the gate rejects outcome predictions in the reply."}, {"id": "hackathon_idea_ai_swarm_dynamics_brief_apart_research_ai_collusion_research_sprint", "label": "Apart Research AI Collusion Research Sprint", "file_type": "concept", "source_file": "hackathon-idea/ai-swarm-dynamics/brief.md", "source_location": "brief.md Stage 1b", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Oct 23-25 2026, three weeks after this event, with a 'Detection and Audit of Collusion' track covering evidentiary standards. Its rubric - Impact Potential & Innovation, Execution Quality, Presentation & Clarity - is the nearest comparable, for calibration only. Winner sample N=3, too small for a base rate."}], "edges": [{"source": "hackathon_idea_ai_swarm_dynamics_brief_theme_tools_we_wished_we_had_for_the_hugging_face_incident", "target": "hackathon_idea_ai_swarm_dynamics_idea_package_ai_swarm_dynamics_hackathon", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "hackathon-idea/ai-swarm-dynamics/brief.md", "source_location": "brief.md", "weight": 1.0}, {"source": "hackathon_idea_ai_swarm_dynamics_brief_theme_tools_we_wished_we_had_for_the_hugging_face_incident", "target": "hackathon_idea_ai_swarm_dynamics_brief_openai_hugging_face_incident", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "hackathon-idea/ai-swarm-dynamics/brief.md", "source_location": "brief.md", "weight": 1.0}, {"source": "hackathon_idea_ai_swarm_dynamics_brief_theme_tools_we_wished_we_had_for_the_hugging_face_incident", "target": "hackathon_idea_ai_swarm_dynamics_brief_german_wiki_incident", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "hackathon-idea/ai-swarm-dynamics/brief.md", "source_location": "brief.md", "weight": 1.0}, {"source": "hackathon_idea_ai_swarm_dynamics_brief_organizers_suggested_project_list", "target": "hackathon_idea_ai_swarm_dynamics_idea_package_ai_swarm_dynamics_hackathon", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "hackathon-idea/ai-swarm-dynamics/brief.md", "source_location": "brief.md", "weight": 1.0}, {"source": "hackathon_idea_ai_swarm_dynamics_brief_assumed_rubric_to_design_against", "target": "hackathon_idea_ai_swarm_dynamics_idea_package_constraint_no_published_judging_criteria", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "hackathon-idea/ai-swarm-dynamics/brief.md", "source_location": "brief.md", "weight": 1.0}, {"source": "hackathon_idea_ai_swarm_dynamics_brief_apart_research_ai_collusion_research_sprint", "target": "hackathon_idea_ai_swarm_dynamics_brief_assumed_rubric_to_design_a