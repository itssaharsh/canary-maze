{"nodes": [{"id": "architecture_canary_maze", "label": "Canary Maze (System Architecture)", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One deployable, one datastore, no model on the proof path. Every component maps to an acceptance criterion; one process, stdlib plus Flask."}, {"id": "architecture_gate_py", "label": "gate.py", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": "Component table", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Forced by AC-1 and the privacy constraint. Without it this is a visitor-tracking tool."}, {"id": "architecture_context_py", "label": "context.py", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": "Component table", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "J1 and J2 need a context identifier that is stable without being an identity claim."}, {"id": "architecture_mint_py", "label": "mint.py", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": "Component table", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "J1. HMAC keyed by a rotating salt; the salt epoch is stored so old secrets still verify."}, {"id": "architecture_ledger_py", "label": "ledger.py", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": "Component table", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "J1 to J3. Append-only SQLite; the only writer."}, {"id": "architecture_detect_py", "label": "detect.py", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": "Component table", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AC-3 and AC-4. The one branching function a judge will probe hardest."}, {"id": "architecture_bundle_py", "label": "bundle.py", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": "Component table", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "J3, AC-5 and AC-6. The deliverable that outlives the server."}, {"id": "architecture_figure_py", "label": "figure.py", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": "Component table", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The viewer's figure, rendered server-side so the viewer stays a static file."}, {"id": "architecture_maze_py", "label": "maze.py", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": "Component table", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The surface an automated client must reach to be minted for. Plumbing; never demoed."}, {"id": "architecture_app_py", "label": "app.py", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": "Component table", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Routing only."}, {"id": "architecture_adr_0001_sqlite_append_only_one_file", "label": "ADR-0001 (Architecture): SQLite, Append-Only, One File", "file_type": "rationale", "source_file": "ARCHITECTURE.md", "source_location": "Decisions", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Triggers for re-reading: proposing Postgres or a second datastore, concurrency concerns, or ops/hosting changes. One deployable with zero ops, and the durable artifact is the bundle, not the database. Postgres would add a service for no gain: nothing here is concurrent beyond one process, and the record a third party checks is a file."}, {"id": "architecture_adr_0005_merkle_root_over_canonicalized_rows", "label": "ADR-0005: Merkle Root Over Canonicalized Rows", "file_type": "rationale", "source_file": "ARCHITECTURE.md", "source_location": "Decisions", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Triggers for re-reading: changing the row serialization, the hash function, or anything about bundle export. Rows are serialized with sorted keys and no whitespace, SHA-256 leaf-hashed and combined into a root, so a verifier needs the file and nothing else: no server, no network, no trust in the operator. This is the whole wedge, so it is the one place worth the extra 40 lines."}, {"id": "architecture_deliberate_omissions", "label": "Deliberate Omissions", "file_type": "rationale", "source_file": "ARCHITECTURE.md", "source_location": "Not present, deliberately", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No queue, cache, second datastore, ORM, auth, user accounts, actor table, background jobs, or model on the proof path. Re-read before adding any of them: each absence is a decision, not an oversight."}, {"id": "architecture_never_block_a_crawler", "label": "Never Block a Crawler", "file_type": "rationale", "source_file": "ARCHITECTURE.md", "source_location": "Review gate", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If SQLite is locked the mint path retries once and then serves the page WITHOUT minting, because a blocked crawler is a lost sighting. Also why the deploy must carry no proof-of-work gate in front of it: the gate would block the traffic the tool exists to observe."}, {"id": "architecture_hmac_salt_rotation_and_epoch", "label": "HMAC Salt Rotation and Stored Epoch", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": "Review gate", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The HMAC salt is the only secret: env var, never committed, rotated daily, with the epoch stored per mint so rotation never invalidates history."}, {"id": "architecture_review_gate", "label": "Architecture Review Gate", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": "Review gate", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Necessity, simplest viable, dependency failure, data growth, state and secrets, observability, what can be cut. Concluded no fresh architect reviewer is needed: no money, no auth, no personal data beyond /24-truncated IPs, no data-loss risk."}], "edges": [{"source": "architecture_gate_py", "target": "_prod_build_contract_ac_1", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ARCHITECTURE.md", "source_location": "Component table", "weight": 1.0}, {"source": "architecture_mint_py", "target": "_prod_build_contract_ac_2", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "ARCHITECTURE.md", "source_location": "Component table", "weight": 1.0}, {"source": "architecture_detect_py", "target": "_prod_build_contract_ac_3", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ARCHITECTURE.md", "source_location": "Component table", "weight": 1.0}, {"source": "architecture_detect_py", "target": "_prod_build_contract_ac_4", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ARCHITECTURE.md", "source_location": "Component table", "weight": 1.0}, {"source": "architecture_bundle_py", "target": "_prod_build_contract_ac_5", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ARCHITECTURE.md", "source_location": "Component table", "weight": 1.0}, {"source": "architecture_bundle_py", "target": "_prod_build_contract_ac_6", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ARCHITECTURE.md", "source_location": "Component table", "weight": 1.0}, {"source": "architecture_min