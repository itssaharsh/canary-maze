{"nodes": [{"id": "hackathon_idea_ai_swarm_dynamics_defaults_d1_swarm_discovery_crawler", "label": "D1 Swarm Discovery Crawler", "file_type": "concept", "source_file": "hackathon-idea/ai-swarm-dynamics/defaults.md", "source_location": "defaults.md", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Organizer suggestion 1, verbatim. Crawl public platforms and flag clusters of agent-run accounts. Recycled shape: coordinated-inauthentic-behaviour detection, a well-funded field."}, {"id": "hackathon_idea_ai_swarm_dynamics_defaults_d2_better_transcript_summarizer", "label": "D2 Better Transcript Summarizer", "file_type": "concept", "source_file": "hackathon-idea/ai-swarm-dynamics/defaults.md", "source_location": "defaults.md", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Organizer suggestion 2. Hierarchical / map-reduce summarization of 170k agent messages into a readable brief. Recycled shape: document/thread summarizer."}, {"id": "hackathon_idea_ai_swarm_dynamics_defaults_d3_agent_trajectory_visualizer", "label": "D3 Agent Trajectory Visualizer", "file_type": "concept", "source_file": "hackathon-idea/ai-swarm-dynamics/defaults.md", "source_location": "defaults.md", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Organizer suggestion 2. Timeline and tree explorer for agent traces. Recycled shape: generic dashboard / LLM tracing - Langfuse, LangSmith and Phoenix all ship this."}, {"id": "hackathon_idea_ai_swarm_dynamics_defaults_d4_standard_question_battery", "label": "D4 Standard Question Battery", "file_type": "concept", "source_file": "hackathon-idea/ai-swarm-dynamics/defaults.md", "source_location": "defaults.md", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Organizer suggestion 3. A runner asking ~20 pre-written questions of any multi-agent group. Recycled shape: generic research agent plus LLM-judge."}, {"id": "hackathon_idea_ai_swarm_dynamics_defaults_d5_ai_whistleblowing_channel", "label": "D5 AI Whistleblowing Channel", "file_type": "concept", "source_file": "hackathon-idea/ai-swarm-dynamics/defaults.md", "source_location": "defaults.md", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Organizer suggestion 4. An endpoint making it easy to report agent misbehaviour. Recycled shape: 'an agent that does X'. Already shipped as agenthotline.ai."}, {"id": "hackathon_idea_ai_swarm_dynamics_defaults_d6_information_spread_tracer", "label": "D6 Information-Spread Tracer", "file_type": "concept", "source_file": "hackathon-idea/ai-swarm-dynamics/defaults.md", "source_location": "defaults.md", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Organizer suggestion 5. Track how a claim, instruction or meme propagates through a group of agents. Recycled shape: graph analytics."}, {"id": "hackathon_idea_ai_swarm_dynamics_defaults_d7_open_source_intel_forensics_tracer", "label": "D7 Open-Source-Intel Forensics Tracer", "file_type": "concept", "source_file": "hackathon-idea/ai-swarm-dynamics/defaults.md", "source_location": "defaults.md", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Organizer suggestion 6. Go beyond transcripts and use the web plus digital forensics to reconstruct what happened. Recycled shape: generic research agent. Independently found to be the emptiest slot on the list."}, {"id": "hackathon_idea_ai_swarm_dynamics_defaults_d8_incident_aggregator_dataset", "label": "D8 Incident Aggregator Dataset", "file_type": "concept", "source_file": "hackathon-idea/ai-swarm-dynamics/defaults.md", "source_location": "defaults.md", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Organizer suggestion 7. Every agent-swarm incident in one schema'd, queryable place. Recycled shape: dataset-as-a-project; the AI Incident Database and the OECD AI Incidents Monitor already exist."}, {"id": "hackathon_idea_ai_swarm_dynamics_defaults_d9_generic_multi_agent_observability_dashboard", "label": "D9 Generic Multi-Agent Observability Dashboard", "file_type": "concept", "source_file": "hackathon-idea/ai-swarm-dynamics/defaults.md", "source_location": "defaults.md", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Added unprompted by every model. Spans, token spend, error rates. Recycled shape: generic / 'AI-powered' dashboard."}, {"id": "hackathon_idea_ai_swarm_dynamics_defaults_d10_chat_with_the_corpus", "label": "D10 Chat With the Corpus", "file_type": "concept", "source_file": "hackathon-idea/ai-swarm-dynamics/defaults.md", "source_location": "defaults.md", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Added unprompted. Retrieval over the transcript dump, ask it anything. Recycled shape: chat with your documents/data - generic RAG."}, {"id": "hackathon_idea_ai_swarm_dynamics_defaults_d11_agent_text_detector", "label": "D11 Agent-Text Detector", "file_type": "concept", "source_file": "hackathon-idea/ai-swarm-dynamics/defaults.md", "source_location": "defaults.md", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Added unprompted. A classifier saying 'this post was written by an agent'. Recycled shape: content classifier; a wrapper on a model API."}, {"id": "hackathon_idea_ai_swarm_dynamics_defaults_d12_multi_agent_simulation_sandbox", "label": "D12 Multi-Agent Simulation Sandbox", "file_type": "concept", "source_file": "hackathon-idea/ai-swarm-dynamics/defaults.md", "source_location": "defaults.md", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Added unprompted. Spin up N agents, watch emergent behaviour, screenshot it. Recycled shape: a generic multi-agent system."}, {"id": "hackathon_idea_ai_swarm_dynamics_defaults_d13_embedding_and_umap_cluster_map", "label": "D13 Embedding and UMAP Cluster Map", "file_type": "concept", "source_file": "hackathon-idea/ai-swarm-dynamics/defaults.md", "source_location": "defaults.md", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Added unprompted. Embedding plus UMAP map of agent messages coloured by topic. Recycled shape: generic dashboard."}, {"id": "hackathon_idea_ai_swarm_dynamics_defaults_d14_llm_judge_intent_scorer", "label": "D14 LLM-Judge Intent Scorer", "file_type": "concept", "source_file": "hackathon-idea/ai-swarm-dynamics/defaults.md", "source_location": "defaults.md", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Added unprompted. Score deception, goal drift and sycophancy per message 1-5. Recycled shape: 'check X against rules and flag it'."}, {"id": "hackathon_idea_ai_swarm_dynamics_defaults_d15_anomaly_detector_over_agent_logs", "label": "D15 Anomaly Detector Over Agent Logs", "file_type": "concept", "source_file": "hackathon-idea/ai-swarm-dynamics/defaults.md", "source_location": "defaults.md", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Added unprompted. Statistical outliers flagged for review. Recycled shape: 'check X against rules and flag it'."}, {"id": "hackathon_idea_ai_swarm_dynamics_defaults_d16_agent_passport_identity_registry", "label": "D16 Agent Passport / Identity Registry", "file_type": "concept", "source_file": "hackathon-idea/ai-swarm-dynamics/defaults.md", "source_location": "defaults.md", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Added unprompted. Attestations of who runs which agent, possibly on-chain. Recycled shape: NFT / token-gated / cross-chain."}, {"id": "hackathon_idea_ai_swarm_dynamics_defaults_d17_browser_extension_labelling_agent_posts", "label": "D17 Browser Extension Labelling Agent Posts", "file_type": "concept", "source_file": "hackathon-idea/ai-swarm-dynamics/defaults.md", "source_location": "defaults.md", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Added unprompted. Labels agent-written posts on a social platform. Recycled shape: content classifier wrapper."}, {"id": "hackathon_idea_ai_swarm_dynamics_defaults_d18_auto_written_incident_report", "label": "D18 Auto-Written Incident Report", "file_type": "concept", "source_file": "hackathon-idea/ai-swarm-dynamics/defaults.md", "source_location": "defaults.md", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Added unprompted. Feed the logs, get a post-mortem document. Recycled shape: generic research agent; AI report writer."}, {"id": "hackathon_idea_ai_swarm_dynamics_defaults_d19_mcp_server_exposing_the_corpus", "label": "D19 MCP Server Exposing the Corpus", "file_type": "concept", "source_file": "hackathon-idea/ai-swarm-dynamics/defaults.md", "source_location": "defaults.md", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Added unprompted. So any model can query the corpus. Recycled shape: wrapper on a model API."}, {"id": "hackathon_idea_ai_swarm_dynamics_defaults_d20_slack_or_discord_digest_bot", "label": "D20 Slack or Discord Digest Bot", "file_type": "concept", "source_file": "hackathon-idea/ai-swarm-dynamics/defaults.md", "source_location": "defaults.md", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Added unprompted. 'What did our agents do overnight?'. Recycled shape: AI note taker / meeting summarizer."}, {"id": "hackathon_idea_ai_swarm_dynamics_defaults_d21_agentic_soc_triage_queue", "label": "D21 Agentic SOC Triage Queue", "file_type": "concept", "source_file": "hackathon-idea/ai-swarm-dynamics/defaults.md", "source_location": "defaults.md", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Added unprompted. An agentic version of an existing SIEM/alerting workflow. Recycled shape: agentic version of existing SaaS."}, {"id": "hackathon_idea_ai_swarm_dynamics_defaults_d22_swarm_red_team_harness", "label": "D22 Swarm Red-Team Harness", "file_type": "concept", "source_file": "hackathon-idea/ai-swarm-dynamics/defaults.md", "source_location": "defaults.md", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Added unprompted. Inject a jailbreak into one agent and see if it spreads. Recycled shape: generic multi-agent system."}, {"id": "hackathon_idea_ai_swarm_dynamics_defaults_pre_registered_reduction_sentence", "label": "Pre-Registered Reduction Sentence", "file_type": "concept", "source_file": "hackathon-idea/ai-swarm-dynamics/defaults.md", "source_location": "defaults.md Section C", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'The user gives 170k agent transcripts to a model and gets a summary / a list of suspicious clusters back.' Written before a single lookup as the single highest-risk reduction sentence for this event. Every candidate had to be checked against it explicitly; the Swarm brief / question battery matched it verbatim and died."}, {"id": "hackathon_idea_ai_swarm_dynamics_defaults_do_not_return_here_default_list", "label": "Do-Not-Return-Here Default List", "file_type": "rationale", "source_file": "hackathon-idea/ai-swarm-dynamics/defaults.md", "source_location": "defaults.md", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "defaults.md is a do-not-return-here list written before any search: any final idea that matches a default on (same user + same job) or (same job + same mechanism) dies unless it carries a research-backed wedge. It deliberately includes every organizer suggestion, because those are the most converged ideas in the room."}, {"id": "hackathon_idea_ai_swarm_dynamics_defaults_generation_rules", "label": "Generation Rules", "file_type": "rationale", "source_file": "hackathon-idea/ai-swarm-dynamics/defaults.md", "source_location": "defaults.md Section E", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "1. Seed from a user group's own words, never from the theme's words. 2. At least one non-US group and one non-specialist/consumer-adjacent group. 3. No lens supplies more than half the pool; rules/deadlines <=1/3; capability lens <=1/4. 4. If a batch comes back as duplicates, change the SEED (different user, different kind of source), not the temperature."}, {"id": "hackathon_idea_ai_swarm_dynamics_defaults_saturation_notes", "label": "Saturation Notes", "file_type": "concept", "source_file": "hackathon-idea/ai-swarm-dynamics/defaults.md", "source_location": "defaults.md Section D", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Agents are about 1 in 4 community-hackathon submissions in 2026; chatbot prototypes were the typical 2025 output. Already-crowded, well-funded adjacent fields a prior-art probe must clear: LLM tracing/observability, agent evals, log analysis, graph analytics, bot detection, coordinated-inauthentic-behaviour detection, digital forensics. Everyone at this event has read the same incident reports."}], "edges": [{"source": "hackathon_idea_ai_swarm_dynamics_defaults_pre_registered_reduction_sentence", "target": "hackathon_idea_ai_swarm_dynamics_idea_package_ai_swarm_dynamics_hackathon", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "hackathon-idea/ai-swarm-dynamics/defaults.md", "source_location": "defaults.md", "weight": 0.5}, {"source": "hackathon_idea_ai_swarm_dynamics_defaults_do_not_return_here_default_list", "target": "hackathon_idea_ai_swarm_dynamics_idea_package_ai_swarm_dynamics_hackathon", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "so