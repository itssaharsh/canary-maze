{"nodes": [{"id": "docs_memory_decisions_adr_0001_no_model_on_the_proof_path_laundered_matching_se_no_model_on_the_proof_path", "label": "ADR-0001: No Model on the Proof Path", "file_type": "rationale", "source_file": "docs/memory/decisions/ADR-0001-no-model-on-the-proof-path-laundered-matching-se.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TRIGGERS (re-read this decision when any of these come up): adding AI to the verification path, inference cost, model availability. A verbatim sighting is an HMAC table lookup, so the proof path makes no model call. Laundered (paraphrased) token matching lives in a separate table that is never joined into the proof graph and ships disabled, so a judge can switch the model off and diff the proof graph to byte-identical. Also removes the inference bill, which matters because this entrant gets no compute reimbursement. Governs canarymaze/bundle.py and canarymaze/detect.py."}], "edges": [{"source": "docs_memory_decisions_adr_0001_no_model_on_the_proof_path_laundered_matching_se_no_model_on_the_proof_path", "target": "_prod_build_contract_zero_inference_budget", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/memory/decisions/ADR-0001-no-model-on-the-proof-path-laundered-matching-se.md", "source_location": null, "weight": 1.0}, {"source": "docs_memory_decisions_adr_0001_no_model_on_the_proof_path_laundered_matching_se_no_model_on_the_proof_path", "target": "architecture_bundle_py", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/memory/decisions/ADR-0001-no-model-on-the-proof-path-laundered-matching-se.md", "source_location": null, "weight": 1.0}, {"source": "docs_memory_decisions_adr_0001_no_model_on_the_proof_path_laundered_matching_se_no_model_on_the_proof_path", "target": "architecture_detect_py", "relation": "rationale_for", "confidence": "EXTRACT